# A version published with a stolen token does its damage
# in the days before somebody notices and has it taken down.
# Waiting 7 days from publication gives somebody else the chance to notice first.
# It applies only to an install that resolves versions,
# not to one that installs the locked versions, such as `npm ci`.
min-release-age = 7

# No scope is exempt, `@openreachtech/*` included. What the window guards
# against is a version published from a stolen token, and a stolen token
# publishes under a legitimate scope — so an exemption for the ORT packages
# would open the hole in front of `postinstall`, the one path here that runs
# code on every clone. The single command that does need the window off is the
# lockfile refresh, and the contribution section of the README carries it.

# Stop the install, rather than warn, when a dependency has an install script that
# `allowScripts` in `package.json` does not cover.
strict-allow-scripts = true

# Tag a release `0.9.0`, not `v0.9.0`, when `npm version` creates the tag.
tag-version-prefix =

# ⚠️ Never a credential in this file. It is tracked, so a token written here
# arrives as a modification to a file that is already committed — the one
# shape a secret takes that no ignore rule can catch and that nothing in
# `git status` makes look unusual. npm reads a token from ~/.npmrc or from
# the NPM_TOKEN environment variable, and neither travels with a clone.
