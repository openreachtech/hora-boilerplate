# A version published with a stolen token does its damage
# in the days before somebody notices and has it taken down.
# Waiting 7 days from publication gives somebody else the chance to notice first.
# It applies only to an install that resolves versions,
# not to one that installs the locked versions, such as `npm ci`.
min-release-age = 7

# From npm 12, an install script of a dependency is blocked by default
# unless `allowScripts` permits it.
# Stopping the install on a script that nothing permits brings that behavior to npm 11,
# so that an install in CI and one by hand act the same on npm 11 and npm 12.
strict-allow-scripts = true

# The empty value is not an omission.
# It makes `npm version` create the tag `1.2.3` rather than `v1.2.3`.
tag-version-prefix =

# ⚠️ This file is tracked by Git, so never write a token in it.
